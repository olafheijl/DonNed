---
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';
import '../styles/site.css';
import Brand from '../components/Brand.astro';
import { navigation, ui, locale } from '../content';
const { title, description = '[Beschrijving pagina]' } = Astro.props;
const active = (path: string) => path === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(path);
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | DonNed</title>
</head>
<body>
<a class="skip" href="#inhoud">{ui.skip}</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="DonNed — Home"><Brand /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hoofdnavigatie"><span aria-hidden="true">☰</span> {ui.menu}</button>
    <nav id="hoofdnavigatie" aria-label={ui.mainNav}>
      {navigation.map(([path, label]) => <a href={path} aria-current={Astro.url.pathname === path ? 'page' : undefined} class:list={[{ active: active(path), 'nav-contact': path === '/contact/' }]}>{label}</a>)}
    </nav>
  </div>
</header>
<main id="inhoud"><slot /></main>
<footer class="footer">
  <div class="shell footer-grid">
    <div><a class="brand" href="/" aria-label="DonNed — Home"><Brand /></a><p>[Korte bedrijfsomschrijving]</p></div>
    <nav aria-label={ui.footerNav}>{navigation.map(([path, label]) => <a href={path}>{label}</a>)}</nav>
    <div class="footer-address"><h2>Contact</h2><p>[Zakelijk e-mailadres]<br/>[Telefoonnummer]</p><span>[LinkedIn-link]</span></div>
  </div>
  <div class="shell footer-base"><span>© DonNed</span><a href="/privacyverklaring/">Privacyverklaring</a><a href="/cookiebeleid/">Cookiebeleid</a></div>
</footer>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const close = () => menu?.setAttribute('aria-expanded', 'false');
  header?.classList.add('interactive');
  menu?.addEventListener('click', () => menu.setAttribute('aria-expanded', String(menu.getAttribute('aria-expanded') !== 'true')));
  header?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
      close();
      menu.focus();
    }
  });
  header?.querySelectorAll('nav a').forEach(link => link.addEventListener('click', close));
</script>
</body>
</html>
