---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Visual from '../components/Visual.astro';
import Metrics from '../components/Metrics.astro';
import Pipeline from '../components/Pipeline.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Callout from '../components/Callout.astro';
import Brand from '../components/Brand.astro';
import { ui, sections, pipeline, audiences } from '../content';
---
<Site title="Home" description="[Introductietekst DonNed]">
  <Hero home title="[Hoofdtitel]" intro="[Introductietekst DonNed]" image="/beelden/Rechts Centraal.jpg" />
  <section class="partner-strip">
    <div class="shell">
      <header class="strip-heading"><h2>{sections.partners}</h2><a class="text-link" href="/samenwerkingen/">Bekijk samenwerkingen <span aria-hidden="true">→</span></a></header>
      <ul class="partner-grid">{Array.from({ length: 5 }, () => <li>[Logo samenwerkingspartner]</li>)}</ul>
    </div>
  </section>
  <Section title={sections.challenge} tone="mist">
    <div class="split">
      <div><p class="lead">[Beschrijving maatschappelijke zorguitdaging]</p>
        <dl class="compact-stats">{['Zorgvraag', 'Toegang tot oogzorg', 'Maatschappelijke impact'].map(label => <div><dt>{label}</dt><dd><strong>[Statistiek]</strong><span>[Wetenschappelijke bron]</span></dd></div>)}</dl>
      </div>
      <Visual label="[Afbeelding maatschappelijke zorguitdaging]"/>
    </div>
  </Section>
  <Section title={sections.science} intro="[Beschrijving klinische validatie]" tone="dark">
    <Metrics />
    <a class="button secondary" href="/onderzoek-validatie/">{ui.research}<span aria-hidden="true">→</span></a>
  </Section>
  <Section title={sections.ai}>
    <div class="split">
      <Visual label="[Visualisatie modelarchitectuur]" kind="architecture"/>
      <div><p class="lead">[Beschrijving AI-model]</p><a class="text-link" href="/ai-technologie/">{ui.technology} <span aria-hidden="true">→</span></a></div>
    </div>
    <Pipeline steps={pipeline}/>
  </Section>
  <Section title="RetScan" tone="mist">
    <div class="split">
      <div><Brand product/><p class="lead">[Beschrijving RetScan]</p><a class="button primary" href="/retscan/">{ui.discover}<span aria-hidden="true">→</span></a></div>
      <Visual label="[Visualisatie netvliesanalyse]" kind="retina"/>
    </div>
  </Section>
  <Section title={sections.practice} intro="[Beschrijving klinische implementatie]">
    <div class="editorial-grid">{audiences.map(label => <article><Visual label="[Afbeelding doelgroep]"/><h3>{label}</h3><p>[Beschrijving doelgroep]</p><a class="text-link" href="/samenwerkingen/#implementatie">{ui.more} →</a></article>)}</div>
  </Section>
  <Section title={sections.projects} intro="[Introductie onderzoeksprojecten]" tone="mist">
    <div class="split"><Visual label="[Visualisatie onderzoeksproject]" kind="graph"/><div><h3>[Titel onderzoeksproject]</h3><p>[Beschrijving onderzoeksproject]</p><a class="text-link" href="/onderzoek-validatie/#projecten">{ui.research} →</a></div></div>
  </Section>
  <Section title={sections.news}>
    <ArticleGrid />
    <div class="actions"><a class="text-link" href="/nieuws-inzichten/">Bekijk nieuws & inzichten →</a><a class="text-link" href="/onderzoek-validatie/#publicaties">{ui.publications} →</a></div>
  </Section>
  <Callout />
</Site>
