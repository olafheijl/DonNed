---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Visual from '../components/Visual.astro';
import Metrics from '../components/Metrics.astro';
import Pipeline from '../components/Pipeline.astro';
import Callout from '../components/Callout.astro';
import ContactForm from '../components/ContactForm.astro';
import Comparison from '../components/Comparison.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import { pages, ui, pipeline, partnerGroups, publications, newsCategories, articles, placeholders } from '../content';

export function getStaticPaths() {
  return Object.entries(pages).map(([slug, page]) => ({ params: { slug }, props: { page } }));
}
const { page } = Astro.props;
const slug = Astro.params.slug;
const product = slug === 'retscan';
const research = slug === 'onderzoek-validatie';
const technology = slug === 'ai-technologie';
const legal = slug === 'privacyverklaring' || slug === 'cookiebeleid';
---
<Site title={page.title} description={placeholders(page.intro)}>
  <Hero title={page.title} intro={placeholders(page.intro)} visual={page.visual ? placeholders(page.visual) : undefined}
    kind={product ? 'retina' : technology ? 'architecture' : research ? 'graph' : 'frame'} product={product}/>
  {technology && <Section title="Modelontwikkeling" intro="[Beschrijving modelontwikkeling]"><Pipeline steps={pipeline}/></Section>}
  {product && <Section title="Werking van RetScan" intro="[Beschrijving werking RetScan]"><Pipeline steps={['Netvliesbeeld', 'Beeldvoorbewerking', 'AI-analyse', 'Interpretatie']}/></Section>}
  {(product || technology) && <Section title="Verklaarbare AI" intro="[Beschrijving verklaarbare AI]" tone="mist"><Comparison /></Section>}
  {(research || product || technology) && <Section title="Wetenschappelijke resultaten" intro="[Beschrijving wetenschappelijke resultaten]" tone="dark"><Metrics /></Section>}
  {page.modules.length > 0 && <Section title={product ? 'Technologie en toepassing' : research ? 'Klinische studies en methodologie' : technology ? 'Technologische verdieping' : 'Digitaal Oognetwerk Nederland'}>
    <div class="editorial-grid modules">{page.modules.map(name => <article><h3>{name}</h3><p>{placeholders(`Beschrijving ${name.toLocaleLowerCase('nl')}`)}</p>{name === 'Team' && <Visual label="[Afbeelding teamlid]"/>}{name === 'Productvoordelen' && <ul class="benefits">{Array.from({ length: 6 }, () => <li>[Beschrijving productvoordeel]</li>)}</ul>}</article>)}</div>
  </Section>}
  {research && <>
    <Section id="publicaties" title="Wetenschappelijke publicaties" tone="mist">
      {publications.map(publication => <article class="publication"><h3>{publication.title}</h3>
        <p>{publication.authors} · {publication.date} · {publication.journal}</p>
        <dl><div><dt>DOI</dt><dd>{publication.doi}</dd></div><div><dt>Bron</dt><dd>{publication.sourceUrl ? <a href={publication.sourceUrl}>{publication.sourceLabel}</a> : publication.sourceLabel}</dd></div>
        <div><dt>Download</dt><dd>{publication.downloadUrl ? <a href={publication.downloadUrl}>{publication.downloadLabel}</a> : publication.downloadLabel}</dd></div></dl>
      </article>)}
    </Section>
    <Section id="projecten" title="Lopende onderzoeksprojecten" intro="[Introductie onderzoeksprojecten]">
      <div class="split"><Visual label="[Visualisatie onderzoeksproject]" kind="graph"/><div><h3>[Titel onderzoeksproject]</h3><p>[Beschrijving onderzoeksproject]</p></div></div>
    </Section>
  </>}
  {product && <Section title="Veelgestelde vragen" tone="mist">
    <details class="faq"><summary>[Veelgestelde vraag over RetScan]</summary><p>[Antwoord op veelgestelde vraag]</p></details>
    <div class="actions"><a class="text-link" href="/onderzoek-validatie/">{ui.research} →</a><a class="text-link" href="/contact/">Vraag een demonstratie aan →</a></div>
  </Section>}
  {slug === 'samenwerkingen' && partnerGroups.map(([group, categories], index) => <Section id={index ? 'implementatie' : 'wetenschap'} title={group}
    intro={index ? '[Beschrijving implementatiepartners]' : '[Beschrijving onderzoekspartners]'} tone={index ? 'mist' : 'white'}>
    <div class="editorial-grid">{categories.map(name => <article><h3>{name}</h3><Visual label="[Logo samenwerkingspartner]"/><p>[Beschrijving samenwerking]</p></article>)}</div>
    <a class="text-link" href="/contact/">{ui.collaborate} →</a>
  </Section>)}
  {slug === 'nieuws-inzichten' && <>
    <Section title="Uitgelicht artikel">
      <div class="split"><Visual label="[Afbeelding uitgelicht artikel]"/><div><h3>{articles[0].title}</h3><p>{articles[0].summary}</p><a class="text-link" href={`/nieuws-inzichten/${articles[0].slug}/`}>{ui.more} →</a></div></div>
    </Section>
    <Section title="Artikelen" tone="mist">
      <div class="news-list">
        <label class="filter">{ui.filter} <select id="nieuwsfilter" disabled><option value="">{ui.all}</option>{newsCategories.map(category => <option>{category}</option>)}</select></label>
        <p role="status" id="filtermelding"></p>
        <ArticleGrid/>
      </div>
    </Section>
  </>}
  {slug === 'contact' && <Section title={ui.contact}><div class="contact-layout"><ContactForm/><aside><h3>Contactgegevens</h3><p>[Zakelijk e-mailadres]</p><p>[Telefoonnummer]</p></aside></div></Section>}
  {!legal && slug !== 'contact' && <Callout/>}
</Site>
<script>
  const filter = document.querySelector<HTMLSelectElement>('#nieuwsfilter');
  const cards = document.querySelectorAll<HTMLElement>('.news-list article[data-category]');
  const status = document.querySelector('#filtermelding');
  if (filter && status) {
    filter.addEventListener('change', () => {
      let count = 0;
      cards.forEach(card => {
        card.hidden = Boolean(filter.value && card.dataset.category !== filter.value);
        if (!card.hidden) count++;
      });
      status.textContent = count === 1 ? '1 artikel weergegeven.' : `${count} artikelen weergegeven.`;
    });
    filter.disabled = false;
  }
</script>
