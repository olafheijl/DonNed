---
const { product = false } = Astro.props;
import { existsSync } from 'node:fs';
const file = product ? 'logo retscan.jpg' : 'Logo DONNED.jpg';
const label = product ? 'RetScan' : 'DonNed';
const available = existsSync('public/merken/' + file);
---
{available ?
  <img class=class:list={['brand-img', { 'brand-img--retscan': product }]} src={`/merken/${encodeURIComponent(file)}`} alt={label} width="140" height="46"/> :
  <span class="brand-name">{label}<span aria-hidden="true">.</span></span>}
