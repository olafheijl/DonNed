---
interface Props { title: string; intro?: string; id?: string; tone?: 'white' | 'mist' | 'dark'; }
const { title, intro, id, tone = 'white' } = Astro.props;
---
<section id={id} class:list={['section', tone]}>
  <div class="shell">
    <header class="section-heading"><h2>{title}</h2>{intro && <p>{intro}</p>}</header>
    <slot />
  </div>
</section>
