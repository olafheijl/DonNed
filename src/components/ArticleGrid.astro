---
import Visual from './Visual.astro';
import { articles, ui } from '../content';
interface Props { items?: typeof articles; }
const { items = articles } = Astro.props;
---
<div class="article-grid">
  {items.map(article => <article data-category={article.category}>
    <a class="article-image" href={`/nieuws-inzichten/${article.slug}/`} aria-label={`${ui.more} · ${article.category}`}><Visual label={article.image}/></a>
    <p class="meta">{article.category} · {article.date}</p>
    <h3><a href={`/nieuws-inzichten/${article.slug}/`}>{article.title}</a></h3>
    <p>{article.summary}</p>
    <a class="text-link" href={`/nieuws-inzichten/${article.slug}/`}>{ui.more} <span aria-hidden="true">→</span></a>
  </article>)}
</div>
