---
import Visual from './Visual.astro';
---
<div class="comparison">
  <div class="comparison-stage">
    <Visual label="[Origineel netvliesbeeld]" kind="retina"/>
    <div class="comparison-overlay"><Visual label="[Visualisatie AI-analyse]" kind="architecture"/></div>
  </div>
  <label>Vergelijk origineel en AI-analyse <input type="range" min="0" max="100" value="50"/></label>
  <div class="comparison-legend"><span>AI-analyse</span><span>Origineel netvliesbeeld</span></div>
  <p>[Beschrijving heatmap]</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.comparison').forEach(comparison => {
    const range = comparison.querySelector<HTMLInputElement>('input');
    range?.addEventListener('input', () => comparison.style.setProperty('--reveal', range.value + '%'));
  });
</script>
